# Public base URL of the Express API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Same Google OAuth client id as the backend GOOGLE_CLIENT_ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp support number in international format without "+"
NEXT_PUBLIC_WHATSAPP_NUMBER=917010942325
