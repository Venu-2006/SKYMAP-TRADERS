NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
CLIENT_URL=http://localhost:3000

DATABASE_URL=postgresql://skymap:skymap@localhost:5432/skymap?schema=public

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30

GOOGLE_CLIENT_ID=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SKYMAP TRADERS <no-reply@skymaptraders.com>"

# Public URL of this API (used for locally stored uploads when Cloudinary is not configured)
API_PUBLIC_URL=http://localhost:4000
# Seller/company details printed on GST invoices
COMPANY_NAME=SKYMAP TRADERS
COMPANY_GSTIN=
COMPANY_ADDRESS=India
COMPANY_STATE=Tamil Nadu
COMPANY_PHONE=+91 7010942325
